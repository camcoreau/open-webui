# CamCore Open WebUI production inputs
#
# Copy these names into the Portainer/Dockge stack environment. Do not commit a
# populated .env file. Blank required values deliberately make `docker compose
# config` fail.

# Dedicated, single-tenant Microsoft Entra application registration.
CAMCORE_AI_MICROSOFT_TENANT_ID=
CAMCORE_AI_MICROSOFT_CLIENT_ID=
CAMCORE_AI_MICROSOFT_CLIENT_SECRET=

# OpenAI project credential used by Jarvis | CamCore AI. Keep the populated value
# only in the production stack environment or approved secret-management process.
CAMCORE_AI_OPENAI_API_KEY=

# Three independent, stable secrets. Generate each value separately with at least
# 32 random bytes, for example: openssl rand -hex 32
# Keep them unchanged across restarts and upgrades. Store them in the secret manager.
CAMCORE_AI_WEBUI_SECRET_KEY=
CAMCORE_AI_OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=
CAMCORE_AI_OAUTH_CLIENT_INFO_ENCRYPTION_KEY=

# Exact CIDR used by containers on npm-backend. Determine it with:
# docker network inspect npm-backend --format '{{(index .IPAM.Config 0).Subnet}}'
# Never use 0.0.0.0/0 or *.
CAMCORE_AI_PROXY_TRUSTED_CIDR=
